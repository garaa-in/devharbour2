# Dev Harbour Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.

PORT=3000
NODE_ENV=development

# Database Provider ('postgresql' for Supabase Cloud / 'sqlite' for local development & testing)
DB_PROVIDER=postgresql
DB_PATH=./devharbour.sqlite

# Supabase PostgreSQL Database Credentials
# Obtain from Supabase Dashboard -> Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Supabase REST API Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email & OTP Delivery (Resend)
# Obtain API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=verify@auth.devharbour.in
EMAIL_VERIFICATION_SECRET=generate_a_cryptographically_secure_random_string_min_32_chars

# Authentication & Session Security
SESSION_SECRET=generate_a_random_session_secret_key_here
TOKEN_EXPIRY_DAYS=7

# Google OAuth (Optional — for Google Sign-In verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# External Code Execution (Optional — default uses built-in hardened Node VM sandbox)
# JUDGE0_API_KEY=your_rapidapi_judge0_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
